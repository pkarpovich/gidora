+bool NativeWidgetMac::PerformWindowDrag() {
+  remote_cocoa::NativeWidgetNSWindowBridge* bridge =
+      GetInProcessNSWindowBridge();
+  if (!bridge) {
+    return false;
+  }
+  NSWindow* ns_window = bridge->ns_window();
+  if (!ns_window || !ns_window.movable) {
+    return false;
+  }
+  if ((ns_window.styleMask & NSWindowStyleMaskFullScreen) != 0) {
+    return false;
+  }
+  NSEvent* event = NSApp.currentEvent;
+  if (!event || (event.type != NSEventTypeLeftMouseDown &&
+                 event.type != NSEventTypeLeftMouseDragged)) {
+    return false;
+  }
+
+  // Views capture would keep the mouse away from AppKit's drag tracking.
+  ReleaseCapture();
+  [ns_window performWindowDragWithEvent:event];
+  return true;
+}
