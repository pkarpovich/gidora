+#if BUILDFLAG(IS_MAC)
+int OmniboxViewViews::GetDragOperationsForView(views::View* sender,
+                                              const gfx::Point& p) {
+  // GetDragOperations() runs before OnMousePressed(). Returning DRAG_NONE while
+  // the field is unfocused keeps Views from starting a URL drag, so the same
+  // gesture can move the window.
+  if (!HasFocus() && controller() && controller()->edit_model() &&
+      controller()->edit_model()->focus_state() == OMNIBOX_FOCUS_NONE &&
+      !IsFullWebUIOmniboxReady()) {
+    return ui::DragDropTypes::DRAG_NONE;
+  }
+  return views::Textfield::GetDragOperationsForView(sender, p);
+}
+
+bool OmniboxViewViews::CanDeferPressForWindowDrag(
+    const ui::MouseEvent& event) const {
+  if (replaying_unfocused_click_ || !location_bar_view_ ||
+      IsFullWebUIOmniboxReady()) {
+    return false;
+  }
+  if (!event.IsOnlyLeftMouseButton() || event.GetClickCount() != 1) {
+    return false;
+  }
+  if (event.IsShiftDown() || event.IsControlDown() || event.IsAltDown() ||
+      event.IsCommandDown()) {
+    return false;
+  }
+  if (HasFocus() || !controller() || !controller()->edit_model() ||
+      controller()->edit_model()->focus_state() != OMNIBOX_FOCUS_NONE ||
+      controller()->IsPopupOpen()) {
+    return false;
+  }
+  views::Widget* const widget = GetWidget();
+  if (!widget || widget->IsFullscreen() || !widget->native_widget_private()) {
+    return false;
+  }
+  auto* const native_widget =
+      static_cast<views::NativeWidgetMac*>(widget->native_widget_private());
+  return native_widget->GetInProcessNSWindowBridge() != nullptr;
+}
+
+ui::MouseEvent OmniboxViewViews::MakeUnfocusedWindowDragPressEvent() const {
+  ui::MouseEvent press(ui::EventType::kMousePressed, unfocused_press_location_,
+                       unfocused_press_root_location_, unfocused_press_time_,
+                       unfocused_press_flags_, unfocused_press_changed_flags_);
+  press.SetClickCount(unfocused_press_click_count_);
+  return press;
+}
+
+bool OmniboxViewViews::StartUnfocusedWindowDrag() {
+  views::Widget* const widget = GetWidget();
+  if (!widget || !widget->native_widget_private()) {
+    return false;
+  }
+  auto* const native_widget =
+      static_cast<views::NativeWidgetMac*>(widget->native_widget_private());
+  return native_widget->PerformWindowDrag();
+}
