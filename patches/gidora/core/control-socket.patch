+constexpr base::TimeDelta kCommandTimeout = base::Seconds(30);
+constexpr char kTimedOut[] = "timed out after 30 s";
+constexpr char kTextScript[] =
+    R"(document.body ? document.body.innerText : "")";
+constexpr char kHtmlScript[] = "document.documentElement.outerHTML";
+constexpr char kLocateScript[] = R"((selector => {
+  const element = document.querySelector(selector);
+  if (!element) {
+    return null;
+  }
+  element.scrollIntoView(
+      {block: "center", inline: "center", behavior: "instant"});
+  const box = element.getBoundingClientRect();
+  return {x: box.left + box.width / 2, y: box.top + box.height / 2};
+}))";
+constexpr auto kClickEvents = std::to_array<std::string_view>(
+    {"mouseMoved", "mousePressed", "mouseReleased"});
+
+using ValueResult = base::expected<base::Value, std::string>;
+using ValueCallback = base::OnceCallback<void(ValueResult)>;
+using Step = base::OnceCallback<void(base::WeakPtr<PageSession> session,
+                                     int tab_id,
+                                     base::DictValue args,
+                                     CommandCallback done)>;
+
+class Completion {
+ public:
+  Completion(base::WeakPtr<PageSessions> sessions,
+             int tab_id,
+             CommandCallback callback)
+      : sessions_(std::move(sessions)),
+        tab_id_(tab_id),
+        callback_(std::move(callback)) {
+    timer_.Start(
+        FROM_HERE, kCommandTimeout,
+        base::BindOnce(&Completion::OnTimeout, base::Unretained(this)));
+  }
+
+  CommandCallback AsCallback() {
+    return base::BindOnce(&Completion::Done, weak_factory_.GetWeakPtr());
+  }
+
+ private:
+  void OnTimeout() { Done(base::unexpected(kTimedOut)); }
+
+  void Done(CommandResult result) {
+    std::move(callback_).Run(std::move(result));
+    if (sessions_) {
+      sessions_->Release(tab_id_);
+    }
+    delete this;
+  }
+
+  base::WeakPtr<PageSessions> sessions_;
+  const int tab_id_;
+  CommandCallback callback_;
+  base::OneShotTimer timer_;
+  base::WeakPtrFactory<Completion> weak_factory_{this};
+};
+
+void RunOnPage(PageSessions* sessions,
+               base::DictValue args,
+               CommandCallback callback,
+               Step step) {
+  base::expected<ResolvedTab, std::string> tab = ResolveTab(args);
+  if (!tab.has_value()) {
+    std::move(callback).Run(base::unexpected(tab.error()));
+    return;
+  }
+  std::string id = base::NumberToString(tab->id);
+  if (!tab->contents->GetLastCommittedURL().SchemeIsHTTPOrHTTPS()) {
+    std::move(callback).Run(base::unexpected(
+        base::StrCat({"tab ", id, " does not show a web page"})));
+    return;
+  }
+  base::WeakPtr<PageSession> session = sessions->Acquire(tab->contents);
+  if (!session) {
+    std::move(callback).Run(
+        base::unexpected(base::StrCat({"tab ", id, " cannot be inspected"})));
+    return;
+  }
+  Completion* completion =
+      new Completion(sessions->AsWeakPtr(), tab->id, std::move(callback));
+  std::move(step).Run(std::move(session), tab->id, std::move(args),
+                      completion->AsCallback());
+}
+
+std::string ScriptError(const base::DictValue& details) {
+  if (const std::string* description =
+          details.FindStringByDottedPath("exception.description")) {
+    return base::StrCat({"script error: ", *description});
+  }
+  const std::string* text = details.FindString("text");
+  std::string message =
+      base::StrCat({"script error: ", text ? *text : "uncaught exception"});
+  if (const base::Value* value = details.FindByDottedPath("exception.value")) {
+    base::StrAppend(&message, {" ", base::WriteJson(*value).value_or("")});
+  }
+  return message;
+}
+
+void OnEvaluated(ValueCallback callback, PageSession::Result result) {
+  if (!result.has_value()) {
+    std::move(callback).Run(base::unexpected(result.error()));
+    return;
+  }
+  if (const base::DictValue* details = result->FindDict("exceptionDetails")) {
+    std::move(callback).Run(base::unexpected(ScriptError(*details)));
+    return;
+  }
+  base::Value* value = result->FindByDottedPath("result.value");
+  std::move(callback).Run(value ? std::move(*value) : base::Value());
+}
+
+void Evaluate(PageSession* session,
+              std::string_view expression,
+              ValueCallback callback) {
+  session->Send("Runtime.evaluate",
+                base::DictValue()
+                    .Set("expression", expression)
+                    .Set("returnByValue", true)
+                    .Set("awaitPromise", true)
+                    .Set("userGesture", true),
+                base::BindOnce(&OnEvaluated, std::move(callback)));
+}
+
+void ReplyWithString(std::string_view key,
+                     CommandCallback done,
+                     ValueResult value) {
+  if (!value.has_value()) {
+    std::move(done).Run(base::unexpected(value.error()));
+    return;
+  }
+  if (!value->is_string()) {
+    std::move(done).Run(base::unexpected("the page returned no text"));
+    return;
+  }
+  std::move(done).Run(base::DictValue().Set(key, std::move(value.value())));
+}
+
+void ReplyWithValue(CommandCallback done, ValueResult value) {
+  if (!value.has_value()) {
+    std::move(done).Run(base::unexpected(value.error()));
+    return;
+  }
+  std::move(done).Run(base::DictValue().Set("value", std::move(value.value())));
+}
+
+void ReplyWithScreenshot(int tab_id,
+                         CommandCallback done,
+                         PageSession::Result result) {
+  if (!result.has_value()) {
+    std::move(done).Run(base::unexpected(result.error()));
+    return;
+  }
+  std::string* data = result->FindString("data");
+  if (!data) {
+    std::move(done).Run(base::unexpected("the page returned no screenshot"));
+    return;
+  }
+  std::move(done).Run(
+      base::DictValue().Set("id", tab_id).Set("png", std::move(*data)));
+}
+
+void EvaluateFixed(std::string_view script,
+                   std::string_view key,
+                   base::WeakPtr<PageSession> session,
+                   int tab_id,
+                   base::DictValue args,
+                   CommandCallback done) {
+  Evaluate(session.get(), script,
+           base::BindOnce(&ReplyWithString, key, std::move(done)));
+}
+
+void EvaluateRequested(base::WeakPtr<PageSession> session,
+                       int tab_id,
+                       base::DictValue args,
+                       CommandCallback done) {
+  const std::string* expression = args.FindString("expression");
+  if (!expression) {
+    std::move(done).Run(base::unexpected(
+        "invalid request: expression is missing or not a string"));
+    return;
+  }
+  Evaluate(session.get(), *expression,
+           base::BindOnce(&ReplyWithValue, std::move(done)));
+}
+
+void CaptureScreenshot(base::WeakPtr<PageSession> session,
+                       int tab_id,
+                       base::DictValue args,
+                       CommandCallback done) {
+  session->Send("Page.captureScreenshot",
+                base::DictValue().Set("format", "png"),
+                base::BindOnce(&ReplyWithScreenshot, tab_id, std::move(done)));
+}
+
+void ClickStep(base::WeakPtr<PageSession> session,
+               size_t index,
+               double x,
+               double y,
+               CommandCallback done,
+               PageSession::Result previous) {
+  if (!previous.has_value()) {
+    std::move(done).Run(base::unexpected(previous.error()));
+    return;
+  }
+  if (index == kClickEvents.size()) {
+    std::move(done).Run(base::DictValue().Set("x", x).Set("y", y));
+    return;
+  }
+  if (!session) {
+    std::move(done).Run(base::unexpected("tab closed"));
+    return;
+  }
+  bool is_move = index == 0;
+  session->Send(
+      "Input.dispatchMouseEvent",
+      base::DictValue()
+          .Set("type", kClickEvents[index])
+          .Set("x", x)
+          .Set("y", y)
+          .Set("button", is_move ? "none" : "left")
+          .Set("clickCount", is_move ? 0 : 1),
+      base::BindOnce(&ClickStep, session, index + 1, x, y, std::move(done)));
+}
+
+void ClickLocated(base::WeakPtr<PageSession> session,
+                  std::string selector,
+                  CommandCallback done,
+                  ValueResult located) {
+  if (!located.has_value()) {
+    std::move(done).Run(base::unexpected(located.error()));
+    return;
+  }
+  const base::DictValue* point = located->GetIfDict();
+  std::optional<double> x = point ? point->FindDouble("x") : std::nullopt;
+  std::optional<double> y = point ? point->FindDouble("y") : std::nullopt;
+  if (!x || !y) {
+    std::move(done).Run(
+        base::unexpected(base::StrCat({"selector not found: ", selector})));
+    return;
+  }
+  ClickStep(std::move(session), 0, *x, *y, std::move(done), base::DictValue());
+}
+
+void Click(base::WeakPtr<PageSession> session,
+           int tab_id,
+           base::DictValue args,
+           CommandCallback done) {
+  const std::string* selector = args.FindString("selector");
+  std::optional<double> x = args.FindDouble("x");
+  std::optional<double> y = args.FindDouble("y");
+  if (selector && !x && !y) {
+    Evaluate(
+        session.get(),
+        base::StrCat(
+            {kLocateScript, "(", base::GetQuotedJSONString(*selector), ")"}),
+        base::BindOnce(&ClickLocated, session, *selector, std::move(done)));
+    return;
+  }
+  if (!selector && x && y) {
+    ClickStep(std::move(session), 0, *x, *y, std::move(done),
+              base::DictValue());
+    return;
+  }
+  std::move(done).Run(base::unexpected(
+      "invalid request: give either selector or both x and y"));
+}
+
+void ReplyEmpty(CommandCallback done, PageSession::Result result) {
+  if (!result.has_value()) {
+    std::move(done).Run(base::unexpected(result.error()));
+    return;
+  }
+  std::move(done).Run(base::DictValue());
+}
+
+void InsertText(base::WeakPtr<PageSession> session,
+                int tab_id,
+                base::DictValue args,
+                CommandCallback done) {
+  const std::string* text = args.FindString("text");
+  if (!text) {
+    std::move(done).Run(
+        base::unexpected("invalid request: text is missing or not a string"));
+    return;
+  }
+  session->Send("Input.insertText", base::DictValue().Set("text", *text),
+                base::BindOnce(&ReplyEmpty, std::move(done)));
+}
+
+}  // namespace
+
+void TabText(PageSessions* sessions,
+             base::DictValue args,
+             CommandCallback callback) {
+  RunOnPage(sessions, std::move(args), std::move(callback),
+            base::BindOnce(&EvaluateFixed, kTextScript, "text"));
+}
+
+void TabHtml(PageSessions* sessions,
+             base::DictValue args,
+             CommandCallback callback) {
+  RunOnPage(sessions, std::move(args), std::move(callback),
+            base::BindOnce(&EvaluateFixed, kHtmlScript, "html"));
+}
+
+void TabEval(PageSessions* sessions,
+             base::DictValue args,
+             CommandCallback callback) {
+  RunOnPage(sessions, std::move(args), std::move(callback),
+            base::BindOnce(&EvaluateRequested));
+}
+
+void TabShot(PageSessions* sessions,
+             base::DictValue args,
+             CommandCallback callback) {
+  RunOnPage(sessions, std::move(args), std::move(callback),
+            base::BindOnce(&CaptureScreenshot));
+}
+
+void TabClick(PageSessions* sessions,
+              base::DictValue args,
+              CommandCallback callback) {
+  RunOnPage(sessions, std::move(args), std::move(callback),
+            base::BindOnce(&Click));
+}
+
+void TabType(PageSessions* sessions,
+             base::DictValue args,
+             CommandCallback callback) {
+  RunOnPage(sessions, std::move(args), std::move(callback),
+            base::BindOnce(&InsertText));
+}
