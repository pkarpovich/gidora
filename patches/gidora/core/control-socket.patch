+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/gidora/control/page_session.h"
+
+#include <optional>
+#include <utility>
+
+#include "base/containers/span.h"
+#include "base/functional/bind.h"
+#include "base/functional/callback_helpers.h"
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/strings/strcat.h"
+#include "base/strings/string_view_util.h"
+#include "base/task/sequenced_task_runner.h"
+#include "chrome/browser/gidora/control/tab_commands.h"
+#include "content/public/browser/devtools_agent_host.h"
+#include "content/public/browser/web_contents.h"
+#include "url/gurl.h"
+
+namespace gidora::control {
+
+namespace {
+
+constexpr char kTabClosed[] = "tab closed";
+
+}  // namespace
+
+PageSession::PageSession(content::WebContents* contents,
+                         base::OnceClosure on_closed)
+    : on_closed_(std::move(on_closed)) {
+  scoped_refptr<content::DevToolsAgentHost> host =
+      content::DevToolsAgentHost::GetOrCreateFor(contents);
+  if (!host->AttachClient(this)) {
+    return;
+  }
+  host_ = std::move(host);
+  Send("Emulation.setFocusEmulationEnabled",
+       base::DictValue().Set("enabled", true), base::DoNothing());
+}
+
+PageSession::~PageSession() {
+  if (host_) {
+    host_->DetachClient(this);
+  }
+  base::flat_map<int, ResultCallback> pending = std::move(pending_);
+  for (auto& [id, callback] : pending) {
+    std::move(callback).Run(base::unexpected(kTabClosed));
+  }
+}
+
+void PageSession::Send(std::string_view method,
+                       base::DictValue params,
+                       ResultCallback callback) {
+  if (!host_) {
+    std::move(callback).Run(base::unexpected(kTabClosed));
+    return;
+  }
+  int id = next_id_++;
+  std::optional<std::string> message =
+      base::WriteJson(base::DictValue()
+                          .Set("id", id)
+                          .Set("method", method)
+                          .Set("params", std::move(params)));
+  if (!message) {
+    std::move(callback).Run(
+        base::unexpected("the command could not be encoded"));
+    return;
+  }
+  pending_.emplace(id, std::move(callback));
+  host_->DispatchProtocolMessage(this, base::as_byte_span(*message));
+}
+
+base::WeakPtr<PageSession> PageSession::AsWeakPtr() {
+  return weak_factory_.GetWeakPtr();
+}
+
+void PageSession::DispatchProtocolMessage(
+    content::DevToolsAgentHost* agent_host,
+    base::span<const uint8_t> message) {
+  std::optional<base::DictValue> reply = base::JSONReader::ReadDict(
+      base::as_string_view(message), base::JSON_PARSE_RFC);
+  if (!reply) {
+    return;
+  }
+  std::optional<int> id = reply->FindInt("id");
+  if (!id) {
+    return;
+  }
+  auto found = pending_.find(*id);
+  if (found == pending_.end()) {
+    return;
+  }
+  ResultCallback callback = std::move(found->second);
+  pending_.erase(found);
+  if (const base::DictValue* error = reply->FindDict("error")) {
+    const std::string* text = error->FindString("message");
+    std::move(callback).Run(base::unexpected(
+        base::StrCat({"devtools: ", text ? *text : "unknown error"})));
+    return;
+  }
+  base::DictValue* result = reply->FindDict("result");
+  std::move(callback).Run(result ? std::move(*result) : base::DictValue());
+}
+
+void PageSession::AgentHostClosed(content::DevToolsAgentHost* agent_host) {
+  host_ = nullptr;
+  if (on_closed_) {
+    std::move(on_closed_).Run();
+  }
+}
+
+bool PageSession::MayAttachToURL(const GURL& url, bool is_webui) {
+  return !is_webui &&
+         (url.is_empty() || url.IsAboutBlank() || url.SchemeIsHTTPOrHTTPS());
+}
+
+PageSessions::PageSessions() = default;
+
+PageSessions::~PageSessions() {
+  weak_factory_.InvalidateWeakPtrs();
+  std::map<int, Entry> entries = std::move(entries_);
+  entries.clear();
+}
+
+void PageSessions::Keep(content::WebContents* contents) {
+  if (Entry* entry = Ensure(contents)) {
+    entry->kept = true;
+  }
+}
+
+base::WeakPtr<PageSession> PageSessions::Acquire(
+    content::WebContents* contents) {
+  Entry* entry = Ensure(contents);
+  if (!entry) {
+    return nullptr;
+  }
+  ++entry->users;
+  return entry->session->AsWeakPtr();
+}
+
+void PageSessions::Release(int tab_id) {
+  auto found = entries_.find(tab_id);
+  if (found == entries_.end()) {
+    return;
+  }
+  Entry& entry = found->second;
+  --entry.users;
+  if (entry.users > 0 || entry.kept) {
+    return;
+  }
+  Drop(tab_id);
+}
+
+base::WeakPtr<PageSessions> PageSessions::AsWeakPtr() {
+  return weak_factory_.GetWeakPtr();
+}
+
+PageSessions::Entry* PageSessions::Ensure(content::WebContents* contents) {
+  int tab_id = TabIdOf(contents);
+  auto found = entries_.find(tab_id);
+  if (found != entries_.end()) {
+    return &found->second;
+  }
+  auto session = std::make_unique<PageSession>(
+      contents,
+      base::BindOnce(&PageSessions::Drop, weak_factory_.GetWeakPtr(), tab_id));
+  if (!session->is_attached()) {
+    return nullptr;
+  }
+  Entry& entry = entries_[tab_id];
+  entry.session = std::move(session);
+  return &entry;
+}
+
+void PageSessions::Drop(int tab_id) {
+  auto node = entries_.extract(tab_id);
+  if (node.empty()) {
+    return;
+  }
+  base::SequencedTaskRunner::GetCurrentDefault()->DeleteSoon(
+      FROM_HERE, std::move(node.mapped().session));
+}
+
+}  // namespace gidora::control
