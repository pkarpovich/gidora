+// Copyright 2026 The Gidora Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/gidora/control/control_dispatcher.h"
+
+#include <optional>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/strings/strcat.h"
+#include "base/version_info/version_info.h"
+#include "content/public/browser/browser_thread.h"
+
+namespace gidora::control {
+
+namespace {
+
+constexpr char kEncodingFailure[] =
+    R"({"ok":false,"error":"the response could not be encoded"})";
+
+std::string Line(const base::DictValue& envelope) {
+  std::string line = base::WriteJson(envelope).value_or(kEncodingFailure);
+  line.push_back('\n');
+  return line;
+}
+
+void Finish(ReplyCallback reply, CommandResult result) {
+  if (!result.has_value()) {
+    std::move(reply).Run(ErrorLine(result.error()));
+    return;
+  }
+  std::move(reply).Run(Line(base::DictValue()
+                                .Set("ok", true)
+                                .Set("result", std::move(result.value()))));
+}
+
+void Version(base::DictValue args, CommandCallback callback) {
+  std::move(callback).Run(
+      base::DictValue()
+          .Set("app", "Gidora")
+          .Set("version", version_info::GetVersionNumber()));
+}
+
+}  // namespace
+
+std::string ErrorLine(std::string_view message) {
+  return Line(base::DictValue().Set("ok", false).Set("error", message));
+}
+
+ControlDispatcher::ControlDispatcher() {
+  handlers_.emplace("version", base::BindRepeating(&Version));
+}
+
+ControlDispatcher::~ControlDispatcher() = default;
+
+void ControlDispatcher::Dispatch(std::string request, ReplyCallback reply) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  std::optional<base::DictValue> envelope =
+      base::JSONReader::ReadDict(request, base::JSON_PARSE_RFC);
+  if (!envelope) {
+    std::move(reply).Run(ErrorLine("invalid request: not a JSON object"));
+    return;
+  }
+  const std::string* name = envelope->FindString("cmd");
+  if (!name) {
+    std::move(reply).Run(
+        ErrorLine("invalid request: cmd is missing or not a string"));
+    return;
+  }
+  base::DictValue args;
+  if (base::Value* value = envelope->Find("args")) {
+    if (!value->is_dict()) {
+      std::move(reply).Run(ErrorLine("invalid request: args is not an object"));
+      return;
+    }
+    args = std::move(*value).TakeDict();
+  }
+  auto handler = handlers_.find(*name);
+  if (handler == handlers_.end()) {
+    std::move(reply).Run(ErrorLine(base::StrCat({"unknown command: ", *name})));
+    return;
+  }
+  handler->second.Run(std::move(args),
+                      base::BindOnce(&Finish, std::move(reply)));
+}
+
+base::WeakPtr<ControlDispatcher> ControlDispatcher::AsWeakPtr() {
+  return weak_factory_.GetWeakPtr();
+}
+
+}  // namespace gidora::control
