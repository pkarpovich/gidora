+constexpr base::TimeDelta kTabTimeout = base::Seconds(30);
+constexpr char kTimedOut[] = "timed out after 30 s";
+
+bool IsEligible(BrowserWindowInterface* window) {
+  return window->GetType() == BrowserWindowInterface::TYPE_NORMAL &&
+         !window->GetProfile()->IsOffTheRecord();
+}
+
+BrowserWindowInterface* LastActiveEligibleWindow() {
+  BrowserWindowInterface* found = nullptr;
+  ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+      [&found](BrowserWindowInterface* window) {
+        if (!IsEligible(window)) {
+          return true;
+        }
+        found = window;
+        return false;
+      });
+  return found;
+}
+
+ui::PageTransition ApiTransition() {
+  return ui::PageTransitionFromInt(ui::PAGE_TRANSITION_LINK |
+                                   ui::PAGE_TRANSITION_FROM_API);
+}
+
+base::expected<GURL, std::string> WebUrl(const base::DictValue& args) {
+  const std::string* spec = args.FindString("url");
+  if (!spec) {
+    return base::unexpected("invalid request: url is missing or not a string");
+  }
+  GURL url(*spec);
+  if (!url.is_valid() || !url.SchemeIsHTTPOrHTTPS()) {
+    return base::unexpected("unsupported URL: only http and https are allowed");
+  }
+  return url;
+}
+
+class LoadWaiter : public content::WebContentsObserver {
+ public:
+  static void Start(content::WebContents* contents, CommandCallback callback) {
+    LoadWaiter* waiter = new LoadWaiter(contents, std::move(callback));
+    if (!contents->IsLoading()) {
+      waiter->Finish(false);
+    }
+  }
+
+ private:
+  LoadWaiter(content::WebContents* contents, CommandCallback callback)
+      : content::WebContentsObserver(contents), callback_(std::move(callback)) {
+    timer_.Start(
+        FROM_HERE, kTabTimeout,
+        base::BindOnce(&LoadWaiter::Finish, base::Unretained(this), true));
+  }
+
+  void DidStopLoading() override { Finish(false); }
+
+  void WebContentsDestroyed() override {
+    std::move(callback_).Run(base::unexpected("tab closed"));
+    delete this;
+  }
+
+  void Finish(bool loading) {
+    std::move(callback_).Run(
+        base::DictValue()
+            .Set("id", TabIdOf(web_contents()))
+            .Set("url", web_contents()->GetLastCommittedURL().spec())
+            .Set("loading", loading));
+    delete this;
+  }
+
+  CommandCallback callback_;
+  base::OneShotTimer timer_;
+};
+
+class CloseWaiter : public content::WebContentsObserver {
+ public:
+  static void Start(content::WebContents* contents, CommandCallback callback) {
+    new CloseWaiter(contents, std::move(callback));
+  }
+
+ private:
+  CloseWaiter(content::WebContents* contents, CommandCallback callback)
+      : content::WebContentsObserver(contents),
+        id_(TabIdOf(contents)),
+        callback_(std::move(callback)) {
+    timer_.Start(
+        FROM_HERE, kTabTimeout,
+        base::BindOnce(&CloseWaiter::OnTimeout, base::Unretained(this)));
+  }
+
+  void WebContentsDestroyed() override {
+    std::move(callback_).Run(base::DictValue().Set("id", id_));
+    delete this;
+  }
+
+  void OnTimeout() {
+    std::move(callback_).Run(base::unexpected(kTimedOut));
+    delete this;
+  }
+
+  const int id_;
+  CommandCallback callback_;
+  base::OneShotTimer timer_;
+};
