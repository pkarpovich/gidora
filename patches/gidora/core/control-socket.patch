+#include "base/containers/unique_ptr_adapters.h"
+#include "base/files/file_path.h"
+#include "base/functional/bind.h"
+#include "base/logging.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/path_service.h"
+#include "base/strings/string_view_util.h"
+#include "base/task/bind_post_task.h"
+#include "base/time/time.h"
+#include "base/timer/timer.h"
+#include "chrome/browser/gidora/control/control_dispatcher.h"
+#include "chrome/browser/gidora/control/control_prefs.h"
+#include "chrome/common/chrome_paths.h"
+#include "components/prefs/pref_service.h"
+#include "net/base/io_buffer.h"
+#include "net/base/net_errors.h"
+#include "net/socket/stream_socket.h"
+#include "net/socket/unix_domain_server_socket_posix.h"
+#include "net/traffic_annotation/network_traffic_annotation.h"
+
+namespace gidora::control {
+
+namespace {
+
+constexpr base::FilePath::CharType kSocketName[] =
+    FILE_PATH_LITERAL("control.sock");
+constexpr size_t kMaxSocketPathLength = 103;
+constexpr size_t kMaxRequestSize = 1024 * 1024;
+constexpr int kReadBufferSize = 64 * 1024;
+constexpr base::TimeDelta kReadTimeout = base::Seconds(5);
+constexpr int kBacklog = 16;
+
+constexpr net::NetworkTrafficAnnotationTag kTrafficAnnotation =
+    net::DefineNetworkTrafficAnnotation("gidora_control_socket", R"(
+      semantics {
+        sender: "Gidora control socket"
+        description:
+          "Replies to a local command-line client over a unix domain socket "
+          "inside the user data directory. Nothing leaves the device."
+        trigger: "A local process of the same user sends a command."
+        data: "The result of the command, such as the tab list or page text."
+        destination: LOCAL
+      }
+      policy {
+        cookies_allowed: NO
+        setting: "Off by default. The user turns it on in Gidora settings."
+        policy_exception_justification: "Not implemented."
+      })");
+
+using RequestHandler =
+    base::RepeatingCallback<void(std::string request, ReplyCallback reply)>;
+
+bool IsSameUser(const net::UnixDomainServerSocket::Credentials& credentials) {
+  return credentials.user_id == getuid();
+}
+
+class Connection {
+ public:
+  Connection(std::unique_ptr<net::StreamSocket> socket,
+             RequestHandler handler,
+             base::OnceCallback<void(Connection*)> on_done)
+      : socket_(std::move(socket)),
+        handler_(std::move(handler)),
+        on_done_(std::move(on_done)),
+        read_buffer_(
+            base::MakeRefCounted<net::IOBufferWithSize>(kReadBufferSize)) {}
+
+  Connection(const Connection&) = delete;
+  Connection& operator=(const Connection&) = delete;
+
+  void Start() {
+    timer_.Start(FROM_HERE, kReadTimeout, this, &Connection::Close);
+    Read();
+  }
+
+ private:
+  void Read() {
+    while (true) {
+      int result = socket_->Read(
+          read_buffer_.get(), kReadBufferSize,
+          base::BindOnce(&Connection::OnRead, weak_factory_.GetWeakPtr()));
+      if (result == net::ERR_IO_PENDING || !Consume(result)) {
+        return;
+      }
+    }
+  }
+
+  void OnRead(int result) {
+    if (Consume(result)) {
+      Read();
+    }
+  }
+
+  bool Consume(int result) {
+    if (result <= 0) {
+      Close();
+      return false;
+    }
+    base::span<const uint8_t> data =
+        read_buffer_->span().first(static_cast<size_t>(result));
+    auto newline = std::ranges::find(data, '\n');
+    if (!oversized_) {
+      request_.append(base::as_string_view(
+          data.first(static_cast<size_t>(newline - data.begin()))));
+      if (request_.size() > kMaxRequestSize) {
+        oversized_ = true;
+        request_.clear();
+      }
+    }
+    if (newline == data.end()) {
+      return true;
+    }
+    timer_.Stop();
+    if (oversized_) {
+      Respond(ErrorLine("request too large"));
+      return false;
+    }
+    handler_.Run(
+        std::move(request_),
+        base::BindOnce(&Connection::Respond, weak_factory_.GetWeakPtr()));
+    return false;
+  }
+
+  void Respond(std::string line) {
+    size_t size = line.size();
+    write_buffer_ = base::MakeRefCounted<net::DrainableIOBuffer>(
+        base::MakeRefCounted<net::StringIOBuffer>(std::move(line)), size);
+    Write();
+  }
+
+  void Write() {
+    while (write_buffer_->BytesRemaining() > 0) {
+      int result = socket_->Write(
+          write_buffer_.get(), write_buffer_->BytesRemaining(),
+          base::BindOnce(&Connection::OnWritten, weak_factory_.GetWeakPtr()),
+          kTrafficAnnotation);
+      if (result == net::ERR_IO_PENDING) {
+        return;
+      }
+      if (result <= 0) {
+        Close();
+        return;
+      }
+      write_buffer_->DidConsume(result);
+    }
+    Close();
+  }
+
+  void OnWritten(int result) {
+    if (result <= 0) {
+      Close();
+      return;
+    }
+    write_buffer_->DidConsume(result);
+    Write();
+  }
+
+  void Close() { std::move(on_done_).Run(this); }
+
+  std::unique_ptr<net::StreamSocket> socket_;
+  RequestHandler handler_;
+  base::OnceCallback<void(Connection*)> on_done_;
+  scoped_refptr<net::IOBufferWithSize> read_buffer_;
+  scoped_refptr<net::DrainableIOBuffer> write_buffer_;
+  std::string request_;
+  bool oversized_ = false;
+  base::OneShotTimer timer_;
+  base::WeakPtrFactory<Connection> weak_factory_{this};
+};
+
+}  // namespace
+
+class ControlServer::Listener {
+ public:
+  Listener(base::FilePath path, base::WeakPtr<ControlDispatcher> dispatcher)
+      : path_(std::move(path)), dispatcher_(std::move(dispatcher)) {}
+
+  Listener(const Listener&) = delete;
+  Listener& operator=(const Listener&) = delete;
+
+  ~Listener() {
+    DCHECK_CURRENTLY_ON(content::BrowserThread::IO);
+    if (server_) {
+      unlink(path_.value().c_str());
+    }
+  }
+
+  void Start() {
+    DCHECK_CURRENTLY_ON(content::BrowserThread::IO);
+    unlink(path_.value().c_str());
+    auto server = std::make_unique<net::UnixDomainServerSocket>(
+        base::BindRepeating(&IsSameUser), false);
+    int result = server->BindAndListen(path_.value(), kBacklog);
+    if (result != net::OK) {
+      LOG(ERROR) << "The control socket could not listen on " << path_ << ": "
+                 << net::ErrorToString(result);
+      return;
+    }
+    if (chmod(path_.value().c_str(), S_IRUSR | S_IWUSR) != 0) {
+      PLOG(ERROR) << "The control socket permissions could not be set";
+      unlink(path_.value().c_str());
+      return;
+    }
+    server_ = std::move(server);
+    Accept();
+  }
+
+ private:
+  void Accept() {
+    while (true) {
+      int result = server_->Accept(
+          &accepted_,
+          base::BindOnce(&Listener::OnAccepted, weak_factory_.GetWeakPtr()));
+      if (result == net::ERR_IO_PENDING || !Adopt(result)) {
+        return;
+      }
+    }
+  }
+
+  void OnAccepted(int result) {
+    if (Adopt(result)) {
+      Accept();
+    }
+  }
+
+  bool Adopt(int result) {
+    if (result != net::OK) {
+      LOG(ERROR) << "The control socket stopped accepting connections: "
+                 << net::ErrorToString(result);
+      return false;
+    }
+    auto connection = std::make_unique<Connection>(
+        std::move(accepted_),
+        base::BindRepeating(&Listener::Handle, weak_factory_.GetWeakPtr()),
+        base::BindOnce(&Listener::Remove, base::Unretained(this)));
+    Connection* started = connection.get();
+    connections_.insert(std::move(connection));
+    started->Start();
+    return true;
+  }
+
+  void Handle(std::string request, ReplyCallback reply) {
+    content::GetUIThreadTaskRunner({})->PostTask(
+        FROM_HERE,
+        base::BindOnce(&ControlDispatcher::Dispatch, dispatcher_,
+                       std::move(request),
+                       base::BindPostTaskToCurrentDefault(std::move(reply))));
+  }
+
+  void Remove(Connection* connection) {
+    auto found = connections_.find(connection);
+    if (found != connections_.end()) {
+      connections_.erase(found);
+    }
+  }
+
+  const base::FilePath path_;
+  base::WeakPtr<ControlDispatcher> dispatcher_;
+  std::unique_ptr<net::UnixDomainServerSocket> server_;
+  std::unique_ptr<net::StreamSocket> accepted_;
+  base::flat_set<std::unique_ptr<Connection>, base::UniquePtrComparator>
+      connections_;
+  base::WeakPtrFactory<Listener> weak_factory_{this};
+};
+
+ControlServer* ControlServer::GetInstance() {
+  static base::NoDestructor<ControlServer> instance;
+  return instance.get();
+}
+
+ControlServer::ControlServer() = default;
+
+ControlServer::~ControlServer() = default;
+
+void ControlServer::Init(PrefService* local_state) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  registrar_.Init(local_state);
+  registrar_.Add(kControlSocketEnabled,
+                 base::BindRepeating(&ControlServer::OnEnabledChanged,
+                                     base::Unretained(this)));
+  OnEnabledChanged();
+}
+
+void ControlServer::Shutdown() {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  registrar_.Reset();
+  Stop();
+}
+
+void ControlServer::OnEnabledChanged() {
+  if (registrar_.prefs()->GetBoolean(kControlSocketEnabled)) {
+    Start();
+    return;
+  }
+  Stop();
+}
+
+void ControlServer::Start() {
+  if (listener_) {
+    return;
+  }
+  base::FilePath directory;
+  if (!base::PathService::Get(chrome::DIR_USER_DATA, &directory)) {
+    LOG(ERROR) << "The control socket has no user data directory";
+    return;
+  }
+  base::FilePath path = directory.Append(kSocketName);
+  if (path.value().size() > kMaxSocketPathLength) {
+    LOG(ERROR) << "The control socket path is too long for a unix socket: "
+               << path;
+    return;
+  }
+  dispatcher_ = std::make_unique<ControlDispatcher>();
+  listener_.reset(new Listener(std::move(path), dispatcher_->AsWeakPtr()));
+  content::GetIOThreadTaskRunner({})->PostTask(
+      FROM_HERE,
+      base::BindOnce(&Listener::Start, base::Unretained(listener_.get())));
+}
+
+void ControlServer::Stop() {
+  listener_.reset();
+  dispatcher_.reset();
+}
+
