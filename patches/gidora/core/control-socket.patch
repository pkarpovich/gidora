+int TabIdOf(content::WebContents* contents) {
+  return sessions::SessionTabHelper::IdForTab(contents).id();
+}
+
+base::expected<ResolvedTab, std::string> ResolveTab(
+    const base::DictValue& args) {
+  const base::Value* tab = args.Find("tab");
+  if (!tab) {
+    BrowserWindowInterface* window = LastActiveEligibleWindow();
+    if (!window) {
+      return base::unexpected("no browser window");
+    }
+    content::WebContents* contents =
+        window->GetTabStripModel()->GetActiveWebContents();
+    if (!contents) {
+      return base::unexpected("no active tab");
+    }
+    return ResolvedTab{TabIdOf(contents), contents, window};
+  }
+  if (!tab->is_int()) {
+    return base::unexpected("invalid request: tab is not an integer");
+  }
+  int id = tab->GetInt();
+  std::optional<ResolvedTab> found;
+  ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+      [id, &found](BrowserWindowInterface* window) {
+        if (!IsEligible(window)) {
+          return true;
+        }
+        TabStripModel* tabs = window->GetTabStripModel();
+        for (int index = 0; index < tabs->count(); ++index) {
+          content::WebContents* contents = tabs->GetWebContentsAt(index);
+          if (TabIdOf(contents) == id) {
+            found = ResolvedTab{id, contents, window};
+            return false;
+          }
+        }
+        return true;
+      });
+  if (!found) {
+    return base::unexpected(
+        base::StrCat({"unknown tab: ", base::NumberToString(id)}));
+  }
+  return *found;
+}
+
+void TabList(base::DictValue args, CommandCallback callback) {
+  base::ListValue list;
+  ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+      [&list](BrowserWindowInterface* window) {
+        if (!IsEligible(window)) {
+          return true;
+        }
+        TabStripModel* tabs = window->GetTabStripModel();
+        for (int index = 0; index < tabs->count(); ++index) {
+          content::WebContents* contents = tabs->GetWebContentsAt(index);
+          list.Append(
+              base::DictValue()
+                  .Set("id", TabIdOf(contents))
+                  .Set("window", window->GetSessionID().id())
+                  .Set("active", index == tabs->active_index())
+                  .Set("loading", contents->IsLoading())
+                  .Set("url", contents->GetLastCommittedURL().spec())
+                  .Set("title", base::UTF16ToUTF8(contents->GetTitle())));
+        }
+        return true;
+      });
+  std::move(callback).Run(base::DictValue().Set("tabs", std::move(list)));
+}
+
+void TabNew(PageSessions* sessions,
+            base::DictValue args,
+            CommandCallback callback) {
+  base::expected<GURL, std::string> url = WebUrl(args);
+  if (!url.has_value()) {
+    std::move(callback).Run(base::unexpected(url.error()));
+    return;
+  }
+  BrowserWindowInterface* window = LastActiveEligibleWindow();
+  if (!window) {
+    std::move(callback).Run(base::unexpected("no browser window"));
+    return;
+  }
+  NavigateParams params(window, url.value(), ApiTransition());
+  params.disposition = WindowOpenDisposition::kNewBackgroundTab;
+  Navigate(&params);
+  content::WebContents* contents = params.navigated_or_inserted_contents;
+  if (!contents) {
+    std::move(callback).Run(base::unexpected("the tab could not be opened"));
+    return;
+  }
+  sessions->Keep(contents);
+  LoadWaiter::Start(contents, std::move(callback));
+}
+
+void TabGo(base::DictValue args, CommandCallback callback) {
+  base::expected<GURL, std::string> url = WebUrl(args);
+  if (!url.has_value()) {
+    std::move(callback).Run(base::unexpected(url.error()));
+    return;
+  }
+  base::expected<ResolvedTab, std::string> tab = ResolveTab(args);
+  if (!tab.has_value()) {
+    std::move(callback).Run(base::unexpected(tab.error()));
+    return;
+  }
+  content::NavigationController::LoadURLParams load(url.value());
+  load.transition_type = ApiTransition();
+  tab->contents->GetController().LoadURLWithParams(load);
+  LoadWaiter::Start(tab->contents, std::move(callback));
+}
+
+void TabClose(base::DictValue args, CommandCallback callback) {
+  base::expected<ResolvedTab, std::string> tab = ResolveTab(args);
+  if (!tab.has_value()) {
+    std::move(callback).Run(base::unexpected(tab.error()));
+    return;
+  }
+  content::WebContents* contents = tab->contents;
+  CloseWaiter::Start(contents, std::move(callback));
+  contents->Close();
+}
